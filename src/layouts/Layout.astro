---
import portfolio from '../data/portfolio.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = portfolio.seo.title,
  description = portfolio.seo.description
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={portfolio.personal.name} />
    <meta name="keywords" content={portfolio.seo.keywords} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={portfolio.seo.type} />
    <meta property="og:locale" content={portfolio.seo.locale} />
    <meta property="og:site_name" content={portfolio.personal.name} />
    {portfolio.seo.ogImage && <meta property="og:image" content={portfolio.seo.ogImage} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {portfolio.seo.ogImage && <meta name="twitter:image" content={portfolio.seo.ogImage} />}

    <!-- Canonical -->
    {portfolio.seo.siteUrl && <link rel="canonical" href={portfolio.seo.siteUrl} />}
    {portfolio.seo.siteUrl && <link rel="sitemap" href="/sitemap.xml" />}

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: portfolio.personal.name,
      jobTitle: portfolio.personal.title,
      description: portfolio.personal.description,
      email: portfolio.personal.email,
      url: portfolio.seo.siteUrl,
      sameAs: portfolio.social.map(s => s.url).filter(Boolean),
    })} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

    <!-- Preconnect for fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#hero" class="skip-link">Saltar al contenido principal</a>

    <!-- Filtros SVG de distorsion para la corrupcion del virus (se usan via filter: url(#...)) -->
    <svg aria-hidden="true" focusable="false" width="0" height="0" style="position: absolute; width: 0; height: 0; overflow: hidden;">
      <defs>
        <filter id="virus-warp-1" x="-12%" y="-12%" width="124%" height="124%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency="0.01 0.03" numOctaves="2" seed="3" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="9" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="virus-warp-2" x="-15%" y="-15%" width="130%" height="130%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency="0.016 0.045" numOctaves="2" seed="7" result="noise">
            <animate attributeName="seed" values="7;14;2;11;7" calcMode="discrete" dur="0.55s" repeatCount="indefinite" />
          </feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="24" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="virus-warp-3" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency="0.022 0.06" numOctaves="3" seed="12" result="noise">
            <animate attributeName="seed" values="12;5;19;3;12" calcMode="discrete" dur="0.3s" repeatCount="indefinite" />
          </feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="42" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>

    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #0a0a1a;
    --color-bg-secondary: #0f0f2a;
    --color-surface: #151530;
    --color-primary: #7c3aed;
    --color-primary-light: #a78bfa;
    --color-accent: #06b6d4;
    --color-accent-light: #22d3ee;
    --color-text: #e2e8f0;
    --color-text-muted: #a0aec0;
    --color-border: #1e293b;
    --color-glow: rgba(124, 58, 237, 0.3);
    --font-display: 'Orbitron', sans-serif;
    --font-body: 'Inter', sans-serif;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: var(--color-primary) var(--color-bg);
  }

  body {
    font-family: var(--font-body);
    background-color: var(--color-bg);
    color: var(--color-text);
    overflow-x: hidden;
    cursor: none;
  }

  ::-webkit-scrollbar {
    width: 6px;
  }

  ::-webkit-scrollbar-track {
    background: var(--color-bg);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--color-primary);
    border-radius: 3px;
  }

  ::selection {
    background: var(--color-primary);
    color: white;
  }

  a {
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  a:hover {
    color: var(--color-accent-light);
  }

  section {
    position: relative;
  }

  /* Accessibility: Focus visible styles */
  *:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Reduce motion for users who prefer it */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    html {
      scroll-behavior: auto;
    }
  }

  /* ─── Virus: destruccion progresiva de secciones (L1-L3) ───
     Nivel 1: distorsion SVG suave + split RGB + barra glitch que barre
     Nivel 2: warp animado + scanlines + franjas de peligro + jitter
     Nivel 3: warp fuerte + stamp INFECTADO + ruido + texto desordenado
     (el scramble de texto lo hace corruption.ts; los huecos void, el canvas)
     Las clases .virus-lN las aplica corruption.ts sobre #hero/#about/#projects/#skills/#contact.
     El filtro/animacion crea stacking context que contiene los overlays en cada seccion. */

  /* Viñeta roja de alarma en todo el cuerpo mientras hay infeccion */
  body.virus-infecting::after {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9999;
    box-shadow: inset 0 0 150px rgba(239, 68, 68, 0.3);
    animation: virusVignette 2.2s ease-in-out infinite;
  }

  @keyframes virusVignette {
    0%, 100% { opacity: 0.65; }
    50% { opacity: 1; }
  }

  /* Estado critico: daño >= 80% (viñeta roja intensa y rapida) */
  body.virus-critical::after {
    box-shadow: inset 0 0 200px rgba(239, 68, 68, 0.62);
    animation-duration: 0.8s;
  }

  /* Split RGB en el texto de secciones corruptas */
  .virus-l1 :is(h1, h2, h3, h4, h5, p, a, span, li, button, label) {
    text-shadow: 1.5px 0 rgba(239, 68, 68, 0.5), -1.5px 0 rgba(6, 182, 212, 0.5);
  }
  .virus-l2 :is(h1, h2, h3, h4, h5, p, a, span, li, button, label) {
    text-shadow: 2.5px 0 rgba(239, 68, 68, 0.7), -2.5px 0 rgba(6, 182, 212, 0.7);
  }
  .virus-l3 :is(h1, h2, h3, h4, h5, p, a, span, li, button, label) {
    text-shadow: 3.5px 0 rgba(239, 68, 68, 0.85), -3.5px 0 rgba(6, 182, 212, 0.85);
  }

  /* Nivel 1: warp suave estatico + flicker */
  .virus-l1 {
    animation: virusFlicker 5s ease-in-out infinite;
    filter: url(#virus-warp-1) hue-rotate(20deg) saturate(1.2);
  }

  /* Nivel 2: warp animado + jitter */
  .virus-l2 {
    animation: virusFlicker 2.8s ease-in-out infinite, virusJitter 4s steps(2) infinite;
    filter: url(#virus-warp-2) hue-rotate(50deg) saturate(1.6) contrast(1.08);
  }

  /* Nivel 3: warp fuerte animado + jitter agresivo */
  .virus-l3 {
    animation: virusFlicker 1.4s ease-in-out infinite, virusJitter 2.2s steps(3) infinite;
    filter: url(#virus-warp-3) hue-rotate(120deg) saturate(2.2) contrast(1.25) brightness(0.92);
  }

  /* Scanlines + barra glitch que barre la seccion (::before en todos los niveles) */
  .virus-l1::before,
  .virus-l2::before,
  .virus-l3::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 999;
    background:
      linear-gradient(180deg, transparent 44%, rgba(34, 197, 94, 0.5) 49%, rgba(6, 182, 212, 0.4) 51%, transparent 56%),
      repeating-linear-gradient(0deg, rgba(10, 10, 26, 0.24) 0 1px, transparent 1px 3px);
    background-size: 100% 260%, 100% 100%;
    background-repeat: no-repeat, repeat;
    animation: virusSweep 3.4s linear infinite;
  }
  .virus-l2::before {
    animation: virusSweep 2.1s linear infinite;
  }
  .virus-l3::before {
    background:
      linear-gradient(180deg, transparent 40%, rgba(239, 68, 68, 0.55) 48%, rgba(240, 171, 222, 0.45) 52%, transparent 60%),
      repeating-linear-gradient(0deg, rgba(10, 10, 26, 0.38) 0 1px, transparent 1px 3px);
    animation: virusSweep 1.3s linear infinite;
  }

  /* Franjas de peligro diagonales (nivel 2) */
  .virus-l2::after {
    content: '';
    position: absolute;
    inset: -10%;
    pointer-events: none;
    z-index: 999;
    background: repeating-linear-gradient(
      45deg,
      rgba(245, 158, 11, 0.09) 0 16px,
      transparent 16px 32px
    );
    animation: virusHazard 1.4s linear infinite;
  }

  /* Nivel 3: stamp gigante INFECTADO + ruido glitch (sustituye las franjas) */
  .virus-l3::after {
    content: 'INFECTADO';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(2.5rem, 11vw, 8rem);
    font-weight: 900;
    letter-spacing: 0.12em;
    color: transparent;
    -webkit-text-stroke: 2px rgba(239, 68, 68, 0.4);
    transform: rotate(-14deg);
    background:
      linear-gradient(90deg, rgba(34, 197, 94, 0.07) 0 2px, transparent 2px 8px),
      repeating-linear-gradient(115deg, rgba(240, 171, 222, 0.06) 0 12px, transparent 12px 34px);
    animation: virusStamp 1.5s steps(2) infinite, virusNoiseFlicker 0.9s steps(2) infinite;
  }

  /* Nivel 3: bloques de texto desalineados (layout roto) */
  .virus-l3 :is(h1, h2, h3, p, li, blockquote) {
    transform: translateX(5px) rotate(0.4deg);
  }
  .virus-l3 :is(h1, h2, h3, p, li, blockquote):nth-child(even) {
    transform: translateX(-7px) rotate(-0.5deg);
  }

  @keyframes virusFlicker {
    0%, 100% { opacity: 1; }
    48% { opacity: 1; }
    50% { opacity: 0.86; }
    52% { opacity: 1; }
    90% { opacity: 0.94; }
  }

  @keyframes virusJitter {
    0%, 100% { transform: translate(0, 0); }
    25% { transform: translate(-3px, 1px); }
    50% { transform: translate(3px, -2px); }
    75% { transform: translate(-2px, -3px); }
  }

  @keyframes virusSweep {
    0% { background-position: 0 -80%, 0 0; }
    100% { background-position: 0 180%, 0 0; }
  }

  @keyframes virusHazard {
    0% { background-position: 0 0; }
    100% { background-position: 45px 0; }
  }

  @keyframes virusStamp {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 0.55; }
  }

  @keyframes virusNoiseFlicker {
    0% { opacity: 0.75; }
    50% { opacity: 0.3; }
    100% { opacity: 0.75; }
  }

  /* Reduced motion: sin distorsion SVG ni animaciones, solo color estatico */
  @media (prefers-reduced-motion: reduce) {
    .virus-l1 { filter: hue-rotate(20deg) saturate(1.2); }
    .virus-l2 { filter: hue-rotate(50deg) saturate(1.6) contrast(1.08); }
    .virus-l3 { filter: hue-rotate(120deg) saturate(2.2) contrast(1.25); }
    body.virus-infecting::after,
    body.virus-critical::after { animation: none; opacity: 0.8; }
  }

  /* Skip to content link */
  .skip-link {
    position: absolute;
    top: -40px;
    left: 0;
    background: #7c3aed;
    color: white;
    padding: 8px 16px;
    z-index: 100;
    font-family: 'Orbitron', sans-serif;
    font-size: 0.8rem;
    text-decoration: none;
    transition: top 0.3s;
  }

  .skip-link:focus {
    top: 0;
  }
</style>
